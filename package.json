{
  "name": "zappix-gnome-extension",
  "private": true,
  "description": "Developer tooling for the Zappix GNOME Shell extension (lint/format only — not shipped in the extension package).",
  "type": "module",
  "scripts": {
    "lint": "eslint extension.js prefs.js src tests scripts",
    "format": "prettier --write extension.js prefs.js \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.mjs\" \"scripts/**/*.js\"",
    "format:check": "prettier --check extension.js prefs.js \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.mjs\" \"scripts/**/*.js\""
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "espree": "^10.4.0",
    "prettier": "^3.3.3"
  }
}
